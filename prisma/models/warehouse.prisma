model Warehouse {
  id             String        @id @default(uuid(7)) @db.Uuid
  name           String
  warehouseCode  String        @unique @db.VarChar(6)
  addressLine1   String
  zip            String
  stateId        String        @db.Uuid
  state          CountryState  @relation(fields: [stateId], references: [id], onDelete: Restrict)
  countryId      String        @db.Uuid
  country        Country       @relation(fields: [countryId], references: [id], onDelete: Restrict)
  mapLocation    String?
  images         String[]
  description    String?
  supplyStoreIds String[]      @db.Uuid
  yearlyUpkeep   Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  stocks               Stock[]
  outgoingTransactions StockTransaction[] @relation("FromWarehouse")

  @@index([name])
  @@index([countryId])
  @@index([stateId])
}
