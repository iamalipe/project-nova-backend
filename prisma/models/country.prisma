model Country {
  id             String         @id @default(uuid(7)) @db.Uuid
  name           String
  flag           String
  code3          String         @db.VarChar(3)
  code2          String         @db.VarChar(2)
  tz             String
  currency3      String         @db.VarChar(3)
  currencySymbol String
  states         CountryState[]
  users          User[]
  stores         Store[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}
